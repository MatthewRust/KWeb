# Copy to .env and adjust as needed:  Copy-Item .env.example .env
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Postgres
POSTGRES_USER=kweb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kweb
# Port the database is published on, on this machine (used by `npm run dev` in backend/)
POSTGRES_PORT=5432

# Cloudinary, where gallery images are stored. Copy "API environment variable" from the Cloudinary dashboard.
# Leave empty to run without image uploads.
CLOUDINARY_URL=
